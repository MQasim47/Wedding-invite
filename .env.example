# Supabase — the guest-system project (Project Settings > API).
# Copy to .env.local for local work; on Vercel, add both under
# Project Settings > Environment Variables.
#
# ANON key only. It is public by design (it ships in the browser bundle and
# every read/write is gated by Row Level Security / SECURITY DEFINER
# functions). The service role key must NEVER be used here — vite.config.js
# refuses to build with anything but an anon/publishable key.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
